use App\Ship\Parents\Controllers\ApiController as ParentApiController;
use Illuminate\Http\JsonResponse;
use Throwable;

class {{class-name}} extends ParentApiController
{
    /**
     * {{request}}
     *
     * @group {{container-name}}
     *
     * @throws Throwable
     */
    public function __invoke({{request}}Request $request): JsonResponse
    {
        $data = {{request}}Data::from($request->validated());
